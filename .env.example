# Agent Plan 私密后端配置。不要把真实密钥写入前端、报告或提交到版本库。
AGENT_MODEL_MODE=ark_plan
ARK_API_KEY=
ARK_MODEL_ID=doubao-seed-2.1-pro
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_THINKING=disabled
WEB_SEARCH_ENABLED=true

# Optional TypeSafe Jev semantic assessor. Separate account/key; never use ARK_API_KEY here.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_MIN_CONFIDENCE=0.8

# Optional research-library selection and internal memory/semantic components.
# Keep the default until a separate half-year dataset has passed its available-data audit.
AETHER_LIBRARY_PATH=data/library
AETHER_MEMORY_ENABLED=true
AETHER_JUDGMENT_PROVIDER=jev
AETHER_JUDGMENT_MODE=shadow
# Optional, source-bound classification reuse and task-local dynamic checks.
# legacy keeps the prior provider behavior; selective preserves mandatory audit.
AETHER_JUDGMENT_POLICY=legacy
AETHER_CONTEXT_TRIGGER_TOKENS=48000

# Optional local pretrained semantic retrieval. Runtime never downloads weights.
# Keyword retrieval remains available when the optional encoder is absent.
AETHER_MEMORY_HYBRID_ENABLED=true
AETHER_MEMORY_ENCODER_PATH=local/models/potion-multilingual-128M
